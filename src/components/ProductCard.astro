---
import { type Product, productHref, discount, wonText, CATEGORY } from "../lib/content";
interface Props { product: Product }
const { product: p } = Astro.props;
const off = discount(p);
---
<a href={productHref(p)} class="group block no-underline">
  <div class="relative aspect-square overflow-hidden rounded-2xl bg-wash">
    {p.image && <img src={p.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />}
    {p.soldOut && <span class="absolute inset-0 grid place-items-center bg-black/45 text-[15px] font-bold text-white">품절</span>}
  </div>
  <p class="mt-2.5 text-[12px] font-semibold text-brand">{CATEGORY[p.category] ?? ""}</p>
  <p class="mt-0.5 line-clamp-2 text-[15px] font-semibold leading-snug text-ink">{p.name}</p>
  <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5">
    {off > 0 && <span class="num text-[16px] font-bold text-accent">{off}%</span>}
    <span class="num text-[16px] font-bold text-ink">{wonText(p.salePrice)}</span>
    {off > 0 && <span class="num text-[13px] text-ink-faint line-through">{wonText(p.regularPrice)}</span>}
  </p>
</a>
