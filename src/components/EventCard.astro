---
import { type Event, eventHref, periodText } from "../lib/content";
interface Props { event: Event; ended?: boolean }
const { event: e, ended = false } = Astro.props;
---
<a href={eventHref(e)} class="group block no-underline">
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-wash">
    {e.image && <img src={e.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />}
    {ended && <span class="absolute left-3 top-3 rounded-lg bg-black/60 px-2 py-1 text-[12px] font-bold text-white">종료</span>}
  </div>
  <p class="mt-3 text-[17px] font-bold leading-snug text-ink">{e.name}</p>
  {e.subtitle && <p class="mt-0.5 text-[14px] text-ink-soft">{e.subtitle}</p>}
  {periodText(e) && <p class="num mt-1 text-[13px] text-ink-faint">{periodText(e)}</p>}
</a>
