---
// 상품 상세. 원내 상품(결제형)은 수량·장바구니·처방 신청, 진료 예약(예약형)은 진료 방법·날짜·시간·문진을 받는다.
// 주소는 기존 사이트와 같은 /telemedicine/<상품 ID>/ 이다.
import Base from "../../layouts/Base.astro";
import IntakeFields from "../../components/IntakeFields.astro";
import ConsentFields from "../../components/ConsentFields.astro";
import { Minus, Plus, MessageCircle } from "@lucide/astro";
import clinic from "../../data/clinic.json";
import { loadProducts, loadClosures, CATEGORY, discount, wonText, renderMarkdown, type Product } from "../../lib/content";

export async function getStaticPaths() {
  return (await loadProducts()).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const reservation = p.kind === "RESERVATION";
const off = discount(p);
const closures = reservation ? await loadClosures() : [];
const name = p.name.replace(/^\[비대면 가능\]\s*/, "");
const diet = /다이어트/.test(p.name) || p.category === "DIET";
const jsonLd = reservation ? [] : [{
  "@type": "Product", name: p.name, description: p.summary, image: p.image ? new URL(p.image, Astro.site).href : undefined,
  offers: { "@type": "Offer", priceCurrency: "KRW", price: p.salePrice, availability: p.soldOut ? "https://schema.org/SoldOut" : "https://schema.org/InStock" },
}];
---
<Base title={`${name} | ${clinic.name}`} description={p.summary || p.title || name} image={p.image ?? undefined} current={reservation ? "RESERVATION" : "PRODUCT"} bottomBar={false} jsonLd={jsonLd}>
  <section class="wrap grid gap-8 pt-6 md:grid-cols-2 md:pt-10">
    <div>
      <div class="aspect-square overflow-hidden rounded-[24px] bg-wash">
        {p.image && <img src={p.image} alt={name} class="h-full w-full object-cover" data-main-image />}
      </div>
      {p.images.length > 1 && (
        <div class="mt-3 flex gap-2 overflow-x-auto">
          {p.images.map((src) => <button type="button" class="h-16 w-16 flex-none overflow-hidden rounded-xl border border-line" data-thumb={src}><img src={src} alt="" class="h-full w-full object-cover" loading="lazy" /></button>)}
        </div>
      )}
    </div>

    <div>
      {!reservation && <p class="text-[14px] font-semibold text-brand">{CATEGORY[p.category] ?? ""}</p>}
      {reservation && (
        <p class="flex gap-1.5 text-[12px] font-semibold">
          {p.telemedicine && <span class="rounded-md bg-brand-wash px-1.5 py-0.5 text-brand">비대면 가능</span>}
          {p.inPerson && <span class="rounded-md bg-wash px-1.5 py-0.5 text-ink-soft">내원 진료</span>}
        </p>
      )}
      <h1 class="mt-1 text-[24px] font-bold leading-[1.35] sm:text-[28px]">{name}</h1>
      {p.summary && <p class="mt-2 whitespace-pre-line text-[15px] text-ink-soft">{p.summary}</p>}

      {!reservation && (
        <>
          <p class="mt-5 flex items-baseline gap-2">
            {off > 0 && <span class="num text-[24px] font-bold text-accent">{off}%</span>}
            <span class="num text-[26px] font-bold">{wonText(p.salePrice)}</span>
          </p>
          {off > 0 && <p class="num text-[15px] text-ink-faint line-through">{wonText(p.regularPrice)}</p>}
          {p.attributes.length > 0 && (
            <dl class="mt-5 divide-y divide-line border-y border-line text-[14px]">
              {p.attributes.map(([k, v]) => <div class="grid grid-cols-[88px_1fr] gap-3 py-2.5"><dt class="text-ink-faint">{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}
          <div class="mt-5 rounded-2xl bg-wash p-4" data-buy={p.slug} data-price={p.salePrice}>
            <div class="flex items-center justify-between gap-3">
              <span class="line-clamp-1 text-[15px] font-semibold">{p.name}</span>
              <div class="flex flex-none items-center rounded-xl border border-line bg-paper">
                <button type="button" class="grid h-10 w-10 place-items-center text-ink-soft disabled:opacity-30" data-dec aria-label="수량 줄이기"><Minus size={16} /></button>
                <span class="num w-8 text-center font-bold" data-qty>1</span>
                <button type="button" class="grid h-10 w-10 place-items-center text-ink-soft" data-inc aria-label="수량 늘리기"><Plus size={16} /></button>
              </div>
            </div>
            <div class="mt-3 flex items-baseline justify-between border-t border-line pt-3">
              <span class="text-[14px] text-ink-soft">총 상품 금액</span>
              <span class="num text-[20px] font-bold" data-total>{wonText(p.salePrice)}</span>
            </div>
            <p class="mt-1 text-right text-[12px] text-ink-faint">배송비 {wonText(clinic.shipping.base)} · {wonText(clinic.shipping.freeOver)} 이상 무료</p>
          </div>
          <div class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-2 gap-2 border-t border-line bg-paper px-4 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 md:static md:mt-4 md:border-0 md:p-0">
            <button type="button" class="btn btn-secondary btn-xl" data-add disabled={p.soldOut}>장바구니</button>
            <button type="button" class="btn btn-primary btn-xl" data-direct disabled={p.soldOut}>{p.soldOut ? "품절" : "처방 신청"}</button>
          </div>
          <p class="mt-3 hidden text-center text-[14px] font-semibold text-brand" data-added role="status">장바구니에 담았어요. <a href="/cart/" class="underline">장바구니 보기</a></p>
          <a href={clinic.links.kakaoChat} target="_blank" rel="noopener" class="card mt-4 flex items-center justify-between gap-3 px-4 py-3.5 no-underline">
            <span><span class="block text-[13px] text-ink-faint">나와 맞을지 고민된다면?</span><span class="block text-[15px] font-bold text-ink">원장님께 지금 바로 여쭤보세요</span></span>
            <span class="btn btn-weak min-h-10 flex-none px-3 text-[14px]"><MessageCircle size={16} aria-hidden="true" />상담하기</span>
          </a>
        </>
      )}
    </div>
  </section>

  {reservation && (
    <section class="wrap mt-10 max-w-[720px]">
      <form class="space-y-8" data-reserve novalidate>
        <input type="hidden" name="product" value={p.slug} />
        <div data-field>
          <h2 class="text-[18px] font-bold">진료 방법</h2>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <label class="choice"><input type="radio" name="method" value="PHONE" class="sr-only" disabled={!p.telemedicine} checked={p.telemedicine} />전화로 진료</label>
            <label class="choice"><input type="radio" name="method" value="VISIT" class="sr-only" disabled={!p.inPerson} checked={!p.telemedicine} />한의원에서 진료</label>
          </div>
          {!p.telemedicine && <p class="mt-2 text-[13px] text-ink-faint">대면 진료만 가능한 상품이에요.</p>}
        </div>
        <div data-field>
          <h2 class="text-[18px] font-bold" data-date-title>{p.telemedicine ? "전화 진료 날짜" : "방문 날짜"}</h2>
          <div class="mt-3 grid grid-cols-7 gap-1.5 text-center" data-calendar data-closures={JSON.stringify(closures)} data-hours={JSON.stringify(clinic.hours.flatMap((h) => h.days))}></div>
          <input type="hidden" name="date" />
        </div>
        <div data-field>
          <h2 class="text-[18px] font-bold">시간</h2>
          <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6" data-times><p class="col-span-full text-[14px] text-ink-faint">날짜를 먼저 골라 주세요.</p></div>
          <input type="hidden" name="time" />
        </div>
        <fieldset class="space-y-4">
          <legend class="text-[18px] font-bold">예약하는 분</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <div data-field><label class="label" for="r-name">이름</label><input id="r-name" name="name" class="field" autocomplete="name" required maxlength="30" /></div>
            <div data-field><label class="label" for="r-phone">휴대폰 번호</label><input id="r-phone" name="phone" class="field num" type="tel" inputmode="numeric" autocomplete="tel" placeholder="010-0000-0000" required /></div>
          </div>
        </fieldset>
        <IntakeFields diet={diet} symptomLabel="불편한 증상이나 상담받고 싶은 내용" />
        <ConsentFields />
        <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="hidden rounded-2xl bg-wash p-4 text-[15px] font-semibold" data-result role="status"></p>
        <div class="sticky bottom-0 -mx-5 border-t border-line bg-paper px-5 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 sm:static sm:m-0 sm:border-0 sm:p-0">
          <button class="btn btn-primary btn-xl w-full" data-submit>예약하기</button>
        </div>
      </form>
    </section>
  )}

  {p.bodyHtml && <article class="wrap prose mt-14 max-w-[760px] text-center" set:html={p.bodyHtml} />}

  {!reservation && (
    <section class="wrap mt-14 max-w-[760px] space-y-2">
      {[["배송 안내", clinic.policies.shipping], ["주문 취소 안내", clinic.policies.order], ["교환/반품 안내", clinic.policies.return]].map(([t, md]) => (
        <details class="card px-5 py-4"><summary class="cursor-pointer list-none text-[16px] font-bold">{t}</summary><div class="prose mt-3 text-[14px]" set:html={renderMarkdown(md)} /></details>
      ))}
    </section>
  )}
  {!reservation && <div class="h-24 md:hidden"></div>}
</Base>

<script>
  import { addToCart, setDirect, MAX_QTY } from "../../lib/cart";
  import { bindPhone, showErrors, postJson, numOrNull, str } from "../../lib/form";
  import { readAttribution } from "../../lib/attribution";

  const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
  // 한국 날짜(YYYY-MM-DD)
  const kst = (d: Date) => new Date(d.getTime() + 9 * 3600_000).toISOString().slice(0, 10);

  function initBuy() {
    const box = document.querySelector<HTMLElement>("[data-buy]");
    if (!box) return;
    const slug = box.dataset.buy!, price = Number(box.dataset.price);
    let qty = 1;
    const render = () => {
      box.querySelector("[data-qty]")!.textContent = String(qty);
      box.querySelector("[data-total]")!.textContent = won(price * qty);
      box.querySelector<HTMLButtonElement>("[data-dec]")!.disabled = qty <= 1;
    };
    box.querySelector("[data-dec]")!.addEventListener("click", () => { qty = Math.max(1, qty - 1); render(); });
    box.querySelector("[data-inc]")!.addEventListener("click", () => { qty = Math.min(MAX_QTY, qty + 1); render(); });
    document.querySelector("[data-add]")?.addEventListener("click", () => {
      addToCart(slug, qty);
      document.querySelector<HTMLElement>("[data-added]")!.classList.remove("hidden");
    });
    document.querySelector("[data-direct]")?.addEventListener("click", () => { setDirect({ slug, qty }); location.href = "/checkout/"; });
  }

  function initGallery() {
    const main = document.querySelector<HTMLImageElement>("[data-main-image]");
    document.querySelectorAll<HTMLElement>("[data-thumb]").forEach((b) => b.addEventListener("click", () => { if (main) main.src = b.dataset.thumb!; }));
  }

  function initReserve() {
    const form = document.querySelector<HTMLFormElement>("[data-reserve]");
    if (!form) return;
    const openedAt = Date.now();
    bindPhone(form.querySelector('[name="phone"]'));
    const cal = form.querySelector<HTMLElement>("[data-calendar]")!;
    let closures: string[] = JSON.parse(cal.dataset.closures ?? "[]");
    const openDays: number[] = JSON.parse(cal.dataset.hours ?? "[]");
    const times = form.querySelector<HTMLElement>("[data-times]")!;
    const dateInput = form.querySelector<HTMLInputElement>('[name="date"]')!;
    const timeInput = form.querySelector<HTMLInputElement>('[name="time"]')!;
    form.querySelectorAll<HTMLInputElement>('[name="method"]').forEach((r) => r.addEventListener("change", () => {
      form.querySelector("[data-date-title]")!.textContent = r.value === "PHONE" ? "전화 진료 날짜" : "방문 날짜";
    }));

    const days = Array.from({ length: 31 }, (_, i) => kst(new Date(Date.now() + i * 86400_000)));
    const renderCalendar = () => {
      const head = ["일", "월", "화", "수", "목", "금", "토"].map((d) => `<span class="text-[12px] font-semibold text-ink-faint">${d}</span>`);
      const first = new Date(`${days[0]}T00:00:00Z`).getUTCDay();
      const blanks = Array.from({ length: first }, () => "<span></span>");
      const cells = days.map((d) => {
        const wd = new Date(`${d}T00:00:00Z`).getUTCDay();
        const closed = !openDays.includes(wd) || closures.includes(d);
        const [, m, dd] = d.split("-").map(Number);
        return `<button type="button" data-day="${d}" ${closed ? "disabled" : ""} aria-pressed="${dateInput.value === d}"
          class="num flex aspect-square flex-col items-center justify-center rounded-xl text-[15px] font-semibold transition-colors aria-pressed:bg-brand aria-pressed:text-white enabled:hover:bg-wash disabled:text-ink-faint/50">
          ${dd === 1 || d === days[0] ? `<span class="text-[10px] leading-none">${m}월</span>` : ""}${dd}${closed ? '<span class="text-[9px] leading-none">휴진</span>' : ""}</button>`;
      });
      cal.innerHTML = [...head, ...blanks, ...cells].join("");
    };
    renderCalendar();
    // 빌드 뒤에 Twenty에 넣은 휴진일을 반영한다
    fetch("/api/v1/closures").then((r) => (r.ok ? r.json() : null)).then((j) => { if (j?.closures) { closures = j.closures; renderCalendar(); } }).catch(() => {});

    cal.addEventListener("click", async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-day]");
      if (!b || b.disabled) return;
      dateInput.value = b.dataset.day!; timeInput.value = "";
      renderCalendar();
      times.innerHTML = '<p class="col-span-full text-[14px] text-ink-faint">시간을 불러오는 중이에요…</p>';
      try {
        const r = await fetch(`/api/v1/slots?date=${dateInput.value}`);
        const { slots } = await r.json();
        times.innerHTML = slots?.some((s: any) => s.available)
          ? slots.map((s: any) => `<label class="choice num min-h-11"><input type="radio" name="_time" value="${s.time}" class="sr-only" ${s.available ? "" : "disabled"} />${s.time}</label>`).join("")
          : '<p class="col-span-full text-[14px] text-ink-faint">이 날은 예약이 마감됐어요. 다른 날을 골라 주세요.</p>';
      } catch {
        times.innerHTML = `<p class="col-span-full text-[14px] text-err">시간을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>`;
      }
    });
    times.addEventListener("change", (e) => { timeInput.value = (e.target as HTMLInputElement).value; });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const local: Record<string, string> = {};
      if (!str(fd.get("date"))) local.date = "날짜를 골라 주세요.";
      if (!str(fd.get("time"))) local.time = "시간을 골라 주세요.";
      if (!form.checkValidity() || Object.keys(local).length) {
        form.querySelectorAll<HTMLInputElement>("input,textarea").forEach((i) => { if (!i.checkValidity()) local[i.name] ??= i.type === "checkbox" ? "동의가 필요해요." : "입력해 주세요."; });
        showErrors(form, local);
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>("[data-submit]")!;
      btn.disabled = true;
      const body = {
        product: str(fd.get("product")), method: str(fd.get("method")), date: str(fd.get("date")), time: str(fd.get("time")),
        name: str(fd.get("name")), phone: str(fd.get("phone")),
        intake: {
          sex: str(fd.get("intake.sex")), birthYear: numOrNull(fd.get("intake.birthYear")), heightCm: numOrNull(fd.get("intake.heightCm")),
          weightKg: numOrNull(fd.get("intake.weightKg")), pregnancy: str(fd.get("intake.pregnancy")) || "NONE",
          medications: str(fd.get("intake.medications")), conditions: str(fd.get("intake.conditions")), allergies: str(fd.get("intake.allergies")),
          dietHistory: str(fd.get("intake.dietHistory")), symptoms: str(fd.get("intake.symptoms")),
        },
        consents: { privacy: fd.get("consents.privacy") === "on", sensitive: fd.get("consents.sensitive") === "on", marketing: fd.get("consents.marketing") === "on" },
        noticeVersion: str(fd.get("noticeVersion")), website: str(fd.get("website")), formOpenedAt: openedAt, ...readAttribution(),
      };
      const r = await postJson("/api/v1/appointments", body).catch(() => ({ ok: false, status: 0, json: {} as any }));
      btn.disabled = false;
      const out = form.querySelector<HTMLElement>("[data-result]")!;
      if (r.ok) {
        form.querySelectorAll("fieldset, [data-field], [data-submit]").forEach((el) => el.classList.add("hidden"));
        out.classList.remove("hidden");
        out.textContent = `${r.json.label} 예약을 받았어요. 예약 시간에 맞춰 연락드릴게요.`;
        out.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      showErrors(form, r.json.fields ?? {});
      if (r.json.code === "slot_taken" || r.json.error === "slot_taken") cal.querySelector<HTMLButtonElement>(`[data-day="${dateInput.value}"]`)?.click();
      out.classList.remove("hidden");
      out.textContent = r.json.message ?? "예약하지 못했어요. 잠시 후 다시 시도해 주세요.";
    });
  }

  document.addEventListener("astro:page-load", () => { initBuy(); initGallery(); initReserve(); });
</script>
