---
// 주문서(처방 신청). 원본 사이트와 같은 흐름: 결제 → 원장님 전화 진료 → 처방 확정 → 조제·발송.
// 제출하면 주문 API가 결제 대기 주문을 만들고, 나이스페이 결제창(AUTHNICE.requestPay)을 연다.
import Base from "../layouts/Base.astro";
import IntakeFields from "../components/IntakeFields.astro";
import ConsentFields from "../components/ConsentFields.astro";
import clinic from "../data/clinic.json";
import { loadProducts } from "../lib/content";

const catalog = (await loadProducts()).filter((p) => p.kind === "PAYMENT" && p.salesChannel !== "SOO_STORE")
  .map((p) => ({ slug: p.slug, name: p.name, price: p.salePrice, image: p.image, soldOut: p.soldOut, diet: p.category === "DIET", freeShipping: p.freeShipping }));
---
<Base title={`주문서 | ${clinic.name}`} description="처방 신청" task bottomBar={false}>
  <script is:inline src="https://pay.nicepay.co.kr/v1/js/"></script>
  <script is:inline src="https://t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>
  <section class="wrap max-w-[720px] pt-8">
    <h1 class="section-title">처방 신청</h1>
    <p class="section-sub">결제하시면 원장님이 직접 전화로 진료하고, 처방이 확정되면 조제해 보내드려요.</p>

    <form class="mt-8 space-y-10" data-checkout data-catalog={JSON.stringify(catalog)} data-shipping={JSON.stringify(clinic.shipping)} novalidate>
      <section>
        <h2 class="text-[18px] font-bold">주문 상품</h2>
        <ul class="mt-3 divide-y divide-line border-y border-line" data-lines></ul>
        <p class="py-10 text-center text-ink-soft" data-empty hidden>주문할 상품이 없어요. <a href="/telemedicine/product/" class="font-semibold text-brand">원내 상품 보기</a></p>
      </section>

      <fieldset class="space-y-4">
        <legend class="text-[18px] font-bold">주문하는 분</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <div data-field><label class="label" for="name">이름</label><input id="name" name="name" class="field" autocomplete="name" required maxlength="30" /></div>
          <div data-field><label class="label" for="phone">휴대폰 번호</label><input id="phone" name="phone" class="field num" type="tel" inputmode="numeric" autocomplete="tel" placeholder="010-0000-0000" required /></div>
        </div>
        <div data-field>
          <label class="label" for="consultTime">원장님 전화 진료 받기 편한 시간</label>
          <select id="consultTime" name="consultTime" class="field">
            <option value="">언제든 괜찮아요</option>
            <option>평일 오전(10:30~12:00)</option><option>평일 오후(13:00~17:00)</option><option>평일 저녁(17:00~20:00)</option><option>토요일 오전</option>
          </select>
          <p class="mt-1.5 text-[13px] text-ink-faint">결제 뒤 진료시간 안에 {clinic.tel}로 전화드려요.</p>
        </div>
      </fieldset>

      <fieldset class="space-y-4">
        <legend class="text-[18px] font-bold">받는 방법</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class="choice"><input type="radio" name="pickup" value="0" class="sr-only" checked />택배로 받기</label>
          <label class="choice"><input type="radio" name="pickup" value="1" class="sr-only" />한의원 방문 수령</label>
        </div>
        <div class="space-y-3" data-delivery>
          <label class="flex items-center gap-2 text-[15px]"><input type="checkbox" class="size-5 accent-brand" data-same checked />주문하는 분과 받는 분이 같아요</label>
          <div class="grid gap-3 sm:grid-cols-2" data-recipient hidden>
            <div data-field><label class="label" for="rname">받는 분</label><input id="rname" name="recipient.name" class="field" maxlength="30" /></div>
            <div data-field><label class="label" for="rphone">받는 분 휴대폰</label><input id="rphone" name="recipient.phone" class="field num" type="tel" inputmode="numeric" placeholder="010-0000-0000" /></div>
          </div>
          <div data-field>
            <span class="label">주소</span>
            <div class="flex gap-2"><input name="recipient.zip" class="field num w-28 flex-none" placeholder="우편번호" readonly /><button type="button" class="btn btn-secondary min-h-12 flex-none px-4 text-[15px]" data-zip>주소 검색</button></div>
          </div>
          <div data-field><input name="recipient.address1" class="field" placeholder="주소 검색으로 넣어 주세요" readonly /></div>
          <div data-field><input name="recipient.address2" class="field" placeholder="상세 주소(동·호수)" maxlength="100" /></div>
          <div data-field><input name="recipient.memo" class="field" placeholder="배송 메모(예: 문 앞에 놓아 주세요)" maxlength="100" /></div>
        </div>
        <p class="text-[13px] text-ink-faint" data-pickup-note hidden>진료 때 방문 날짜를 정해요. 원내 재고에 따라 택배로 바뀔 수 있어요.</p>
      </fieldset>

      <IntakeFields diet symptomLabel="원장님께 미리 전할 내용" />

      <fieldset>
        <legend class="text-[18px] font-bold">결제 수단</legend>
        <div class="mt-3 grid grid-cols-3 gap-2">
          <label class="choice"><input type="radio" name="payMethod" value="CARD" class="sr-only" checked />신용카드</label>
          <label class="choice"><input type="radio" name="payMethod" value="KAKAOPAY" class="sr-only" />카카오페이</label>
          <label class="choice"><input type="radio" name="payMethod" value="NAVERPAY" class="sr-only" />네이버페이</label>
        </div>
      </fieldset>

      <section class="space-y-1.5 rounded-2xl bg-wash p-5 text-[15px]">
        <div class="flex justify-between"><span class="text-ink-soft">상품 금액</span><span class="num font-semibold" data-items>0원</span></div>
        <div class="flex justify-between"><span class="text-ink-soft">배송비</span><span class="num font-semibold" data-ship>0원</span></div>
        <div class="flex justify-between border-t border-line pt-2 text-[18px]"><span class="font-bold">결제 금액</span><span class="num font-bold text-brand" data-sum>0원</span></div>
        <p class="text-[12px] text-ink-faint">처방 확정 전까지 취소할 수 있고, 진료 결과 처방이 어려우면 전액 환불해 드려요.</p>
      </section>

      <ConsentFields terms dosage />
      <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="hidden rounded-2xl bg-wash p-4 text-[15px] font-semibold text-err" data-result role="alert"></p>
      <div class="sticky bottom-0 -mx-5 border-t border-line bg-paper px-5 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 sm:static sm:m-0 sm:border-0 sm:p-0">
        <button class="btn btn-primary btn-xl w-full" data-submit><span data-sum-btn></span> 결제하기</button>
      </div>
    </form>
  </section>
</Base>

<script>
  import { readCart, readDirect } from "../lib/cart";
  import { bindPhone, showErrors, postJson, str, readIntake, checkMulti } from "../lib/form";
  import { readAttribution } from "../lib/attribution";

  declare const AUTHNICE: { requestPay(o: Record<string, unknown>): void };
  declare const daum: any;
  const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  // 제주·도서산간 판단은 서버가 한다(server/pricing.mjs). 화면은 제주만 미리 보여 준다.
  const isJeju = (zip: string) => /^63[0-6]\d\d$/.test(zip) && Number(zip) <= 63644;

  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("[data-checkout]");
    if (!form) return;
    const openedAt = Date.now();
    const catalog = new Map<string, any>(JSON.parse(form.dataset.catalog!).map((p: any) => [p.slug, p]));
    const ship = JSON.parse(form.dataset.shipping!);
    const direct = readDirect();
    const lines = (direct ? [direct] : readCart()).filter((l) => catalog.has(l.slug));
    const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
    bindPhone($("[name=phone]")); bindPhone($('[name="recipient.phone"]'));

    $("[data-lines]").innerHTML = lines.map((l) => {
      const p = catalog.get(l.slug);
      return `<li class="flex items-center gap-3 py-3">
        <span class="h-14 w-14 flex-none overflow-hidden rounded-xl bg-wash">${p.image ? `<img src="${p.image}" alt="" class="h-full w-full object-cover" />` : ""}</span>
        <span class="min-w-0 flex-1 text-[15px]"><span class="line-clamp-2 font-semibold">${esc(p.name)}</span><span class="num text-ink-faint">${l.qty}개</span></span>
        <span class="num font-bold">${won(p.price * l.qty)}</span></li>`;
    }).join("");
    $<HTMLElement>("[data-empty]").hidden = lines.length > 0;
    $<HTMLButtonElement>("[data-submit]").disabled = lines.length === 0;

    // 다이어트 상품이 없으면 키·몸무게·복용 경험 칸을 숨긴다
    const diet = lines.some((l) => catalog.get(l.slug).diet);
    form.querySelectorAll<HTMLElement>("[data-diet-only]").forEach((el) => {
      el.hidden = !diet;
      el.querySelectorAll<HTMLInputElement>("input").forEach((i) => { i.required = diet; });
    });

    const pickup = () => form.querySelector<HTMLInputElement>('[name="pickup"]:checked')?.value === "1";
    const total = () => {
      const items = lines.reduce((n, l) => n + catalog.get(l.slug).price * l.qty, 0);
      const free = items >= ship.freeOver || lines.every((l) => catalog.get(l.slug).freeShipping);
      const fee = pickup() ? 0 : (free ? 0 : ship.base) + (isJeju(str($<HTMLInputElement>('[name="recipient.zip"]').value)) ? ship.remoteExtra : 0);
      $("[data-items]").textContent = won(items);
      $("[data-ship]").textContent = fee ? won(fee) : "무료";
      $("[data-sum]").textContent = won(items + fee);
      $("[data-sum-btn]").textContent = won(items + fee);
    };
    total();

    form.querySelectorAll('[name="pickup"]').forEach((r) => r.addEventListener("change", () => {
      $<HTMLElement>("[data-delivery]").hidden = pickup();
      $<HTMLElement>("[data-pickup-note]").hidden = !pickup();
      total();
    }));
    $<HTMLInputElement>("[data-same]").addEventListener("change", (e) => { $<HTMLElement>("[data-recipient]").hidden = (e.target as HTMLInputElement).checked; });
    $("[data-zip]").addEventListener("click", () => {
      new daum.Postcode({
        oncomplete: (d: any) => {
          $<HTMLInputElement>('[name="recipient.zip"]').value = d.zonecode;
          $<HTMLInputElement>('[name="recipient.address1"]').value = d.roadAddress || d.jibunAddress;
          $<HTMLInputElement>('[name="recipient.address2"]').focus();
          total();
        },
      }).open();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const out = $<HTMLElement>("[data-result]");
      out.classList.add("hidden");
      const local: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>("input,textarea,select").forEach((i) => {
        if (!i.closest("[hidden]") && !i.checkValidity()) local[i.name] ??= i.type === "checkbox" ? "동의가 필요해요." : "입력해 주세요.";
      });
      if (!pickup() && !str($<HTMLInputElement>('[name="recipient.zip"]').value)) local["recipient.zip"] = "주소 검색으로 우편번호를 넣어 주세요.";
      checkMulti(form, local);
      if (showErrors(form, local)) return;

      const fd = new FormData(form);
      const same = $<HTMLInputElement>("[data-same]").checked;
      const body = {
        name: str(fd.get("name")), phone: str(fd.get("phone")), items: lines, pickup: pickup(), consultTime: str(fd.get("consultTime")),
        payMethod: str(fd.get("payMethod")) || "CARD",
        recipient: pickup() ? {} : {
          name: same ? "" : str(fd.get("recipient.name")), phone: same ? "" : str(fd.get("recipient.phone")),
          zip: str(fd.get("recipient.zip")), address1: str(fd.get("recipient.address1")), address2: str(fd.get("recipient.address2")), memo: str(fd.get("recipient.memo")),
        },
        intake: readIntake(fd, diet),
        consents: {
          privacy: fd.get("consents.privacy") === "on", sensitive: fd.get("consents.sensitive") === "on",
          terms: fd.get("consents.terms") === "on", dosage: fd.get("consents.dosage") === "on", marketing: fd.get("consents.marketing") === "on",
        },
        noticeVersion: str(fd.get("noticeVersion")), website: str(fd.get("website")), formOpenedAt: openedAt, ...readAttribution(),
      };
      const btn = $<HTMLButtonElement>("[data-submit]");
      btn.disabled = true;
      const r = await postJson("/api/v1/orders", body).catch(() => ({ ok: false, status: 0, json: {} as any }));
      btn.disabled = false;
      if (!r.ok) {
        showErrors(form, r.json.fields ?? {});
        out.textContent = r.json.message ?? "주문을 만들지 못했어요. 잠시 후 다시 시도해 주세요.";
        out.classList.remove("hidden");
        return;
      }
      // 결제가 끝나면 완료 페이지가 장바구니를 비운다(바로 처방 신청이면 장바구니는 그대로)
      try { sessionStorage.setItem("biroso_paying", JSON.stringify({ orderNo: r.json.orderNo, direct: Boolean(direct) })); } catch {}
      AUTHNICE.requestPay({
        ...r.json.pay,
        fnError: (res: any) => {
          out.textContent = res?.errorMsg ? `결제창 오류: ${res.errorMsg}` : "결제창을 열지 못했어요. 다시 시도해 주세요.";
          out.classList.remove("hidden");
        },
      });
    });
  });
</script>
