# 맥 셀프호스팅용. 복사해서 .env로 쓰고 권한은 600으로 둔다. 비밀값은 openssl rand -hex 32 로 만든다.

# 도메인. Caddy 주소는 http:// 로 적는다(TLS는 Cloudflare가 끝낸다).
SITE_HOSTS=http://example-clinic.kr, http://www.example-clinic.kr
SITE_URL=https://example-clinic.kr

# Cloudflare Tunnel. Zero Trust > Networks > Tunnels에서 만든 터널의 토큰을 넣고 아래 줄의 주석을 푼다.
CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=public

# Twenty는 공용 스택(~/srv/crm)의 biroso 워크스페이스를 쓴다(주소 https://biroso.<CRM 도메인>).
# 그 워크스페이스의 설정 > APIs & Webhooks에서 발급한 키. 렌탈ON 워크스페이스 키와 섞지 않는다. 비워 두면 api는 뜨지 않고, 홈페이지는 src/data의 기본 콘텐츠로 빌드된다.
TWENTY_API_KEY=
TWENTY_CONTENT_KEY=

# 크론(파기, 재빌드)과 Twenty 워크플로의 재빌드 요청(POST http://biroso-builder:8080/rebuild)
CRON_SECRET=change-me
# 환불 API (POST http://biroso-api:8788/v1/orders/refund, Twenty 워크플로용)
ADMIN_SECRET=change-me

# 나이스페이. S1_/S2_로 시작하면 샌드박스로 승인한다. 비워 두면 결제를 받지 않는다.
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=

NOTICE_VERSIONS=2026-11-01
INTAKE_RETENTION_DAYS=365
PENDING_ORDER_HOURS=24

# 1이면 실제 운영(시범 사이트 표시와 검색 차단을 끈다)
PUBLIC_LIVE=
PUBLIC_GA4_ID=
PUBLIC_NAVER_SITE_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=
